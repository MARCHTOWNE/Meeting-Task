# 复制本文件为 .env.local，并填入你自己的值。
# 不要提交 .env.local。

# Supabase 项目地址，例如 https://abcdefghijklmn.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
# Supabase publishable key（以 sb_publishable_ 开头）。可以公开：
# 所有查询都以当前登录用户的身份执行，并受行级安全（RLS）限制。
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# OpenAI API key（只在服务端使用）
OPENAI_API_KEY=
# 可选：任务提取 Agent 使用的模型（默认 gpt-5-nano，最便宜）
OPENAI_MODEL=
# 可选：每个账号可以免费使用几次 AI 提取（默认 1）
AI_FREE_LIMIT=
# 可选：在多少小时内计数；不填表示终身，也就是"每人免费 N 次"
AI_QUOTA_WINDOW_HOURS=
# 可选：不受次数限制的账号邮箱，多个用逗号分隔（比如你自己的演示账号）
AI_ADMIN_EMAILS=
