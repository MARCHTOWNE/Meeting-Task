# Copy this file to .env.local and fill in your own values.
# Never commit .env.local.

# Supabase project URL, e.g. https://abcdefghijklmn.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
# Supabase publishable key (starts with sb_publishable_). Safe to expose:
# every query runs as the signed-in user and is filtered by Row Level Security.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# OpenAI API key (server-only)
OPENAI_API_KEY=
# Optional: OpenAI model for the task-extraction agent (default: gpt-5-nano, the cheapest)
OPENAI_MODEL=
